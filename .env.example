# ── Supabase ──────────────────────────────
# Local stack (run `pnpm db:start`) — values below are the CLI defaults and are
# identical on every machine. Swap to a hosted project for staging/prod by
# copying values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<run `supabase status` to get this>
SUPABASE_SERVICE_KEY=<run `supabase status` to get this>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Anthropic ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Redis (Upstash) ───────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# ── Email (Resend) ─────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=notifications@yourdomain.com

# ── Google OAuth ──────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── YouTube ───────────────────────────────
YOUTUBE_API_KEY=...

# ── Slack OAuth ───────────────────────────
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# ── Higgsfield (Agent #7 b-roll rendering) ─
# Issued as a key + secret PAIR from the Higgsfield platform dashboard.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# The platform API has NO text2video (verified live against /models):
# b-roll renders as a two-step chain — text2image (Soul) then image2video
# (DoP). Both slugs must exist in GET /models for the account's plan.
HIGGSFIELD_T2I_MODEL=higgsfield-ai/soul/v2/standard
HIGGSFIELD_I2V_MODEL=higgsfield-ai/dop/lite/first-last-frame

# ── Content Agent (Agent #5) pipeline ─────
# All optional: each unconfigured key just skips its pipeline stage.
# Riverside studio audio (preferred podcast source; falls back to YouTube).
RIVERSIDE_API_KEY=
# Opus Clip auto-clipping (plan-gated API).
OPUSCLIP_API_KEY=
# Max seconds to wait for an Opus Clip project before recording a timeout.
CONTENT_CLIP_WAIT_SECONDS=1800
# Transcription backend for podcast chapters: "local" (faster-whisper, free)
# or "openai" (hosted whisper-1; needs OPENAI_API_KEY).
TRANSCRIPTION_PROVIDER=local
# Instagram Reels publishing (dormant until the client's Meta Business
# account + app review exist; the pipeline skips Instagram without these).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Encryption ────────────────────────────
ENCRYPTION_KEY=...

# ── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ENVIRONMENT=development

# Render API key — used for deploy triggers + service-status reads.
# https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=
