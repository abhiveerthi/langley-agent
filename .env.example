# ── Encryption ────────────────────────────
ENCRYPTION_KEY=...

# ── App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=...
ENVIRONMENT=development
