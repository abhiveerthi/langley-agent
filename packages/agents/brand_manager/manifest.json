{
  "slug": "brand-manager",
  "name": "Brand Manager",
  "description": "Gets you paid. Drafts cold outreach to sponsors, researches target brands, sends approved pitches via Resend, and tracks deal stages.",
  "version": "0.2.0",
  "icon": "handshake",
  "tagline": "Gets you paid.",
  "capabilities": ["outreach", "sales", "crm", "writing"],
  "required_integrations": ["resend"],
  "optional_integrations": ["youtube", "slack"],
  "tools": [
    "find_sponsor_leads",
    "research_brand",
    "get_channel_stats",
    "send_pitch_email"
  ],
  "interrupt_before": ["approval_gate"],
  "config_schema": {
    "sender_name": { "type": "string", "label": "Sender display name (defaults to brand.name)" },
    "min_deal_value_usd": { "type": "number", "default": 0, "label": "Minimum deal value to pursue" }
  }
}
